<Window x:Class="Fraktal_Mandelbrota.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Fraktal_Mandelbrota"
        mc:Ignorable="d"
        Title="Generator Zbioru Mandelbrota | Asembler x64 (AVX2) vs C#" 
        Height="900" Width="1400"
        MinHeight="700" MinWidth="1100"
        WindowStartupLocation="CenterScreen"
        Background="#1E1E2E" Foreground="#CDD6F4"
        Loaded="Window_Loaded">

    <Window.Resources>
        <Style TargetType="GroupBox">
            <Setter Property="Foreground" Value="#89B4FA"/>
            <Setter Property="BorderBrush" Value="#45475A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style TargetType="RadioButton">
            <Setter Property="Foreground" Value="#CDD6F4"/>
            <Setter Property="Margin" Value="0,5,0,5"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Background" Value="#313244"/>
            <Setter Property="Foreground" Value="#F5E0DC"/>
            <Setter Property="BorderBrush" Value="#585B70"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="4" 
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#45475A"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.5"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#89B4FA"/>
            <Setter Property="Foreground" Value="#11111B"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#B4BEFE"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#A6E3A1"/>
            <Setter Property="Foreground" Value="#11111B"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#94E2D5"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="340" MinWidth="300" MaxWidth="420"/>
            <ColumnDefinition Width="5"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ================= LEWY PANEL STEROWANIA ================= -->
        <Border Grid.Column="0" Background="#181825" Padding="14">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <!-- Tytuł -->
                    <TextBlock Text="Zbiór Mandelbrota" FontSize="20" FontWeight="Bold" Foreground="#CBA6F7" Margin="0,0,0,2"/>
                    <TextBlock Text="Antyaliasing SSAA 2x2 | x64 Multi-Threading" FontSize="11" Foreground="#6C7086" Margin="0,0,0,14"/>

                    <!-- 1. Wybór silnika (tylko C# oraz ASM) -->
                    <GroupBox Header="1. Silnik obliczeniowy">
                        <StackPanel>
                            <RadioButton x:Name="rbAsm" Content="Asembler x64 DLL (AVX2 / SSE4)" IsChecked="True" Checked="EngineChanged"/>
                            <RadioButton x:Name="rbCs" Content="C# (.NET)" Checked="EngineChanged"/>
                            <TextBlock x:Name="txtEngineInfo" Text="Aktywny silnik: Asembler x64 (AVX2)" FontSize="11" Foreground="#A6ADC8" Margin="0,6,0,0"/>
                        </StackPanel>
                    </GroupBox>

                    <!-- 2. Liczba wątków (1 .. 64) -->
                    <GroupBox Header="2. Liczba wątków (1 .. 64)">
                        <StackPanel>
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Wątki robocze:" VerticalAlignment="Center" Foreground="#BAC2DE"/>
                                <TextBlock x:Name="txtThreadCount" Grid.Column="1" Text="8" FontWeight="Bold" Foreground="#F9E2AF" VerticalAlignment="Center"/>
                            </Grid>
                            <Slider x:Name="slThreads" Minimum="1" Maximum="64" Value="8" IsSnapToTickEnabled="True" TickFrequency="1"
                                    ValueChanged="ThreadsSlider_ValueChanged"/>
                            <TextBlock x:Name="txtCpuLogicalCores" Text="Wykryte wątki CPU: ..." FontSize="11" Foreground="#6C7086" Margin="0,4,0,0"/>
                        </StackPanel>
                    </GroupBox>

                    <!-- 3. Maksymalna liczba iteracji (5 .. 500) -->
                    <GroupBox Header="3. Liczba iteracji (5 .. 500)">
                        <StackPanel>
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Maksymalne iteracje:" VerticalAlignment="Center" Foreground="#BAC2DE"/>
                                <TextBlock x:Name="txtIterations" Grid.Column="1" Text="100" FontWeight="Bold" Foreground="#F9E2AF" VerticalAlignment="Center"/>
                            </Grid>
                            <Slider x:Name="slIterations" Minimum="5" Maximum="500" Value="100" IsSnapToTickEnabled="True" TickFrequency="5"
                                    ValueChanged="IterationsSlider_ValueChanged"/>
                        </StackPanel>
                    </GroupBox>

                    <!-- 4. Zakres współrzędnych i zoom -->
                    <GroupBox Header="4. Zakres współrzędnych">
                        <StackPanel>
                            <TextBlock x:Name="txtCoordsInfo" Text="Re: [-2.000, 1.000]&#x0a;Im: [-1.200, 1.200]" 
                                       FontFamily="Consolas" FontSize="11" Foreground="#94E2D5" Margin="0,0,0,8"/>
                            <Button Content="Resetuj kadr (Domyślny widok)" Click="BtnResetCoords_Click" Margin="0,0,0,4"/>
                            <TextBlock Text="Nawigacja: Kliknij lub użyj kółka myszy na fraktalu, aby przybliżać/oddalać." 
                                       FontSize="10" Foreground="#6C7086" TextWrapping="Wrap"/>
                        </StackPanel>
                    </GroupBox>

                    <!-- Przyciski akcji -->
                    <Button x:Name="btnRender" Content="▶ Generuj Fraktal" Style="{StaticResource PrimaryButton}" 
                            Height="38" FontSize="14" Margin="0,4,0,8" Click="BtnRender_Click"/>
                    
                    <Button x:Name="btnBenchmark" Content="⏱ Uruchom Benchmark (1-64 wątki)" Style="{StaticResource AccentButton}" 
                            Height="34" Margin="0,0,0,10" Click="BtnBenchmark_Click"/>

                    <!-- Pasek postępu benchmarku -->
                    <ProgressBar x:Name="pbProgress" Height="6" Margin="0,0,0,8" Visibility="Collapsed" 
                                 Background="#313244" Foreground="#A6E3A1"/>
                    <TextBlock x:Name="txtStatus" Text="Gotowy" FontSize="12" Foreground="#A6ADC8" TextWrapping="Wrap"/>

                    <!-- Czas ostatniego renderowania -->
                    <Border Background="#11111B" CornerRadius="4" Padding="8" Margin="0,10,0,0">
                        <StackPanel>
                            <TextBlock Text="OSTATNI CZAS GENEROWANIA:" FontSize="10" FontWeight="Bold" Foreground="#6C7086"/>
                            <TextBlock x:Name="txtLastTime" Text="--- ms" FontSize="16" FontWeight="Bold" Foreground="#F38BA8" Margin="0,2,0,0"/>
                            <TextBlock x:Name="txtLastTimeUs" Text="--- µs" FontSize="11" Foreground="#A6ADC8"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Rozdzielacz paneli -->
        <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="#313244"/>

        <!-- ================= PRAWY OBSZAR: FRAKTAL + BENCHMARK PONIŻEJ ================= -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <!-- Widok fraktala -->
                <RowDefinition Height="*" MinHeight="260"/>
                <!-- Rozdzielacz poziomy -->
                <RowDefinition Height="5"/>
                <!-- Panel benchmarku w prawym dolnym rogu pod fraktalem -->
                <RowDefinition Height="230" MinHeight="140"/>
            </Grid.RowDefinitions>

            <!-- 1. Obszar Fraktala (Góra) -->
            <Border Grid.Row="0" Background="#0D0D15">
                <Grid>
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                        <Image x:Name="imgFractal"
                               Stretch="None"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               MouseWheel="ImgFractal_MouseWheel"
                               MouseLeftButtonDown="ImgFractal_MouseLeftButtonDown"
                               Cursor="Cross"/>
                    </ScrollViewer>

                    <!-- Informacja o SSAA 2x2 -->
                    <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="10" 
                            Background="#D0181825" CornerRadius="4" Padding="8,4">
                        <TextBlock Text="SSAA 2x2 (4 próbki na piksel)" FontSize="11" Foreground="#A6ADC8"/>
                    </Border>
                </Grid>
            </Border>

            <!-- Rozdzielacz -->
            <GridSplitter Grid.Row="1" Height="5" HorizontalAlignment="Stretch" Background="#313244"/>

            <!-- 2. Wyniki Benchmarku (Prawy dolny róg pod fraktalem) -->
            <Border Grid.Row="2" Background="#181825" Padding="12,8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Wyniki Benchmarku" FontSize="14" FontWeight="Bold" Foreground="#89B4FA"/>
                            <TextBlock Text=" (Wątki: 1, 2, 4, 8, 16, 32, 64 | Średnia z 5 prób)" 
                                       FontSize="11" Foreground="#A6ADC8" VerticalAlignment="Center" Margin="6,2,0,0"/>
                        </StackPanel>
                        <Button Grid.Column="1" Content="Kopiuj do schowka (CSV)" Padding="8,3" FontSize="11" Click="BtnCopyCsv_Click"/>
                    </Grid>

                    <DataGrid x:Name="dgBenchmark" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True"
                              Background="#11111B" RowBackground="#181825" AlternatingRowBackground="#1E1E2E"
                              Foreground="#CDD6F4" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#313244"
                              BorderBrush="#45475A" HeadersVisibility="Column">
                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#313244"/>
                                <Setter Property="Foreground" Value="#F5E0DC"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="Padding" Value="8,5"/>
                                <Setter Property="BorderThickness" Value="0,0,1,1"/>
                                <Setter Property="BorderBrush" Value="#45475A"/>
                            </Style>
                        </DataGrid.ColumnHeaderStyle>
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Setter Property="Padding" Value="2"/>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Liczba Wątków" Binding="{Binding ThreadsDisplay}" Width="130"/>
                            <DataGridTextColumn Header="Czas C# [ms]" Binding="{Binding TimeCsDisplay}" Width="150"/>
                            <DataGridTextColumn Header="Czas Asembler AVX2 [ms]" Binding="{Binding TimeAsmDisplay}" Width="190"/>
                            <DataGridTextColumn Header="Przyśpieszenie (ASM vs C#)" Binding="{Binding SpeedupDisplay}" Width="200"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
