<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- Obsługa zarówno środowiska z .NET 8 (zgodnie ze specyfikacją), jak i nowszego .NET 10 -->
    <TargetFramework Condition="'$(NetCoreSdkVersion)' &lt; '10.0'">net8.0-windows</TargetFramework>
    <TargetFramework Condition="'$(NetCoreSdkVersion)' &gt;= '10.0'">net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PlatformTarget>x64</PlatformTarget>
    <Platforms>x64;AnyCPU</Platforms>
  </PropertyGroup>

  <!-- Kopiowanie bibliotek natywnych C++ oraz ASM do katalogu wyjściowego aplikacji -->
  <Target Name="CopyNativeDlls" AfterTargets="Build">
    <!-- MandelbrotAsm.dll -->
    <Copy SourceFiles="..\x64\Release\MandelbrotAsm.dll" DestinationFolder="$(TargetDir)" Condition="Exists('..\x64\Release\MandelbrotAsm.dll')" SkipUnchangedFiles="true" />
    <Copy SourceFiles="..\MandelbrotAsm\x64\Release\MandelbrotAsm.dll" DestinationFolder="$(TargetDir)" Condition="!Exists('..\x64\Release\MandelbrotAsm.dll') and Exists('..\MandelbrotAsm\x64\Release\MandelbrotAsm.dll')" SkipUnchangedFiles="true" />
    <Copy SourceFiles="..\x64\Debug\MandelbrotAsm.dll" DestinationFolder="$(TargetDir)" Condition="!Exists('$(TargetDir)MandelbrotAsm.dll') and Exists('..\x64\Debug\MandelbrotAsm.dll')" SkipUnchangedFiles="true" />

    <!-- MandelbrotHighLevel.dll -->
    <Copy SourceFiles="..\x64\Release\MandelbrotHighLevel.dll" DestinationFolder="$(TargetDir)" Condition="Exists('..\x64\Release\MandelbrotHighLevel.dll')" SkipUnchangedFiles="true" />
    <Copy SourceFiles="..\MandelbrotHighLevel\x64\Release\MandelbrotHighLevel.dll" DestinationFolder="$(TargetDir)" Condition="!Exists('..\x64\Release\MandelbrotHighLevel.dll') and Exists('..\MandelbrotHighLevel\x64\Release\MandelbrotHighLevel.dll')" SkipUnchangedFiles="true" />
    <Copy SourceFiles="..\x64\Debug\MandelbrotHighLevel.dll" DestinationFolder="$(TargetDir)" Condition="!Exists('$(TargetDir)MandelbrotHighLevel.dll') and Exists('..\x64\Debug\MandelbrotHighLevel.dll')" SkipUnchangedFiles="true" />
  </Target>

</Project>
